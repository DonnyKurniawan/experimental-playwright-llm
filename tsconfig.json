{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@tests/*": ["tests/*"],
      "@utils/*": ["utils/*"]
    }
  },

  "include": [
    "tests/**/*",
    "utils/**/*",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "playwright-report",
    "test-results"
  ]
}